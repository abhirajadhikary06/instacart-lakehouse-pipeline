# =============================================================================
# .env.example — copy to .env and fill in your values
# Never commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Kaggle API credentials
# Get from https://www.kaggle.com/account → "Create New API Token"
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# -----------------------------------------------------------------------------
# MinIO (object storage / data lake)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Spark cluster resources
# -----------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER1_UI_PORT=8082
SPARK_WORKER2_UI_PORT=8083
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# -----------------------------------------------------------------------------
# dlt pipeline — points at the MinIO container
# Set automatically by ingestion scripts; override only if needed.
# -----------------------------------------------------------------------------
DESTINATION__FILESYSTEM__BUCKET_URL=s3://raw
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=minioadmin
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=minioadmin123
DESTINATION__FILESYSTEM__CREDENTIALS__ENDPOINT_URL=http://localhost:9000
RUNTIME__DLTHUB_TELEMETRY=false

# -----------------------------------------------------------------------------
# Phase 2 — Airflow (fill in when you reach that phase)
# -----------------------------------------------------------------------------
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_PASSWORD=admin
# AIRFLOW_DB_USER=airflow
# AIRFLOW_DB_PASSWORD=airflow
# AIRFLOW_DB_NAME=airflow
# AIRFLOW_DB_PORT=5433
# AIRFLOW_FERNET_KEY=           # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW_WEBSERVER_SECRET_KEY= # generate: python -c "import secrets; print(secrets.token_hex(32))"
# AIRFLOW_WEBSERVER_PORT=8080

# -----------------------------------------------------------------------------
# Phase 3 — PostgreSQL DWH + Metabase
# -----------------------------------------------------------------------------
# POSTGRES_DWH_USER=dwh_user
# POSTGRES_DWH_PASSWORD=dwh_password
# POSTGRES_DWH_DB=instacart_dwh
# POSTGRES_DWH_PORT_HOST=5434
# METABASE_PORT=3000
# METABASE_DB_NAME=metabase

# -----------------------------------------------------------------------------
# Phase 4 — Prometheus + Grafana
# -----------------------------------------------------------------------------
# PROMETHEUS_PORT=9090
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_PORT=3001
